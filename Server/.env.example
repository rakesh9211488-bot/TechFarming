# Copy to Server/.env and supply a dedicated local MySQL account.
# Example placeholders are not working credentials.
HOST=127.0.0.1
PORT=9000
CLIENT_ORIGIN=http://localhost:3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=techfarming_local
DB_PASSWORD=replace-with-your-local-database-password
DB_USERS_DATABASE=techfarming_users_dev
DB_JOBS_DATABASE=techfarming_jobs_dev
